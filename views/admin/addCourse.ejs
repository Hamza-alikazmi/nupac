<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Add Course | NUPAC</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen flex items-center justify-center py-10">

  <div class="w-full max-w-lg bg-white shadow-lg rounded-xl p-8 mx-4">
    <h2 class="text-3xl font-bold text-center text-blue-700 mb-6">Add Course</h2>

    <form method="POST" action="/admin/course/new" class="space-y-5">
      
      <!-- Course Code -->
      <div>
        <label for="code" class="block text-gray-700 font-medium mb-1">Course Code</label>
        <input
          type="text"
          id="code"
          name="code"
          placeholder="e.g., GEN-111"
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-600 focus:outline-none"
          required
        >
      </div>

      <!-- Course Name -->
      <div>
        <label for="name" class="block text-gray-700 font-medium mb-1">Course Name</label>
        <input
          type="text"
          id="name"
          name="name"
          placeholder="Enter course name"
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-600 focus:outline-none"
          required
        >
      </div>

      <!-- Description -->
      <div>
        <label for="description" class="block text-gray-700 font-medium mb-1">Description</label>
        <textarea
          id="description"
          name="description"
          placeholder="Brief course description"
          rows="4"
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-600 focus:outline-none"
        ></textarea>
      </div>

      <!-- Submit Button -->
      <button
        type="submit"
        class="w-full bg-blue-700 hover:bg-blue-800 text-white font-semibold py-2.5 rounded-lg transition duration-200"
      >
        Add Course
      </button>

    </form>
  </div>

</body>
</html>
